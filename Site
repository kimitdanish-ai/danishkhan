:root{--bg-0:#0a2219;--bg-1:#12382a;--bg-2:#1b4d3a;--border:rgba(255,255,255,.13);--border-2:rgba(255,255,255,.2);--gold:#d6c28f;--text:#f4f6f5;--muted:rgba(244,246,245,.8);--muted-2:rgba(244,246,245,.62);--shadow:0 22px 60px rgba(0,0,0,.4);--radius-xl:22px;--radius-lg:16px;--radius-pill:999px}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;min-height:100vh;font-family:Inter,Arial,sans-serif;color:var(--text);background:radial-gradient(1200px 800px at 20% 10%,rgba(214,194,143,.10),transparent 55%),radial-gradient(900px 650px at 85% 25%,rgba(40,130,90,.30),transparent 60%),linear-gradient(135deg,var(--bg-0),var(--bg-1) 45%,var(--bg-2));background-attachment:fixed;display:flex;justify-content:center;padding:28px 16px}
.container{width:100%;max-width:1120px;position:relative;z-index:1}
#flow{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none}
.glow{position:fixed;width:420px;height:420px;border-radius:50%;pointer-events:none;z-index:0;background:radial-gradient(circle,rgba(214,194,143,.13),transparent 65%);transform:translate(-50%,-50%);left:-999px;top:-999px}
.topbar{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;padding:12px 14px;border:1px solid var(--border);background:linear-gradient(180deg,rgba(255,255,255,.08),rgba(255,255,255,.045));border-radius:var(--radius-lg);box-shadow:var(--shadow);backdrop-filter:blur(10px)}
.crumb{font-size:13.5px;color:var(--muted)}
.pillrow{display:flex;gap:10px;flex-wrap:wrap}
.pill{display:inline-flex;align-items:center;gap:8px;padding:9px 13px;border-radius:var(--radius-pill);border:1px solid var(--border);background:rgba(0,0,0,.14);color:var(--text);text-decoration:none;font-size:13.5px;transition:all .15s ease;white-space:nowrap}
.pill:hover{background:rgba(255,255,255,.08);border-color:var(--border-2);transform:translateY(-1px)}
.pill.gold,.pill.on{border-color:rgba(214,194,143,.55);background:rgba(214,194,143,.14)}
.chatbot-float{position:fixed;right:24px;bottom:24px;z-index:999;display:flex;flex-direction:column;align-items:center;gap:8px}
.chatbot-label{font-size:12.5px;color:var(--muted);background:rgba(0,0,0,.35);padding:6px 10px;border-radius:var(--radius-pill);border:1px solid var(--border);backdrop-filter:blur(6px);white-space:nowrap}
.chatbot-btn{width:54px;height:54px;border-radius:50%;background:linear-gradient(180deg,rgba(214,194,143,.35),rgba(214,194,143,.18));border:1px solid rgba(214,194,143,.55);display:flex;align-items:center;justify-content:center;color:var(--text);font-size:22px;text-decoration:none;box-shadow:var(--shadow);transition:transform .15s}
.chatbot-btn:hover{transform:translateY(-2px) scale(1.04)}
.eyebrow{display:inline-block;font-size:12.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);font-weight:600;margin-bottom:12px}
.page-head{margin-top:56px;max-width:720px}
.page-head h1{font-size:clamp(34px,5.5vw,52px);line-height:1.08;font-weight:700;letter-spacing:-.02em;margin:0 0 16px}
.page-head p{font-size:18px;line-height:1.7;color:var(--muted);margin:0}
.tiles{margin-top:48px;display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:22px}
.tile{position:relative;overflow:hidden;cursor:pointer;padding:30px;border-radius:var(--radius-xl);border:1px solid var(--border);background:linear-gradient(180deg,rgba(255,255,255,.085),rgba(255,255,255,.035));box-shadow:var(--shadow);transition:transform .25s,border-color .25s}
.tile::before{content:"";position:absolute;inset:0;background:radial-gradient(380px circle at var(--mx,50%) var(--my,0%),rgba(214,194,143,.16),transparent 60%);opacity:0;transition:opacity .25s;pointer-events:none}
.tile:hover{transform:translateY(-6px);border-color:rgba(214,194,143,.45)}.tile:hover::before{opacity:1}
.tile .ic{font-size:26px;color:var(--gold);margin-bottom:16px}
.tile h3{margin:0 0 8px;font-size:21px;font-weight:600}
.tile p{margin:0;font-size:15px;line-height:1.6;color:var(--muted)}
.tile .more{margin-top:16px;padding-top:0;max-height:0;overflow:hidden;opacity:0;transition:max-height .35s,opacity .35s;color:var(--gold);font-size:14.5px;line-height:1.6}
.tile.active .more{max-height:140px;opacity:1;padding-top:14px;border-top:1px solid var(--border)}
.tile .tap{margin-top:14px;font-size:12.5px;color:var(--muted-2)}
.feature{display:block;text-decoration:none;color:inherit;margin-top:56px;padding:44px;border-radius:var(--radius-xl);border:1px solid rgba(214,194,143,.35);background:linear-gradient(180deg,rgba(255,255,255,.09),rgba(255,255,255,.035));box-shadow:var(--shadow);transition:transform .25s,border-color .25s}
.feature:hover{transform:translateY(-6px);border-color:rgba(214,194,143,.6)}
.feature h2{margin:0 0 14px;font-size:30px;font-weight:700}
.feature p{font-size:17px;line-height:1.7;color:var(--muted);max-width:720px;margin:0 0 16px}
.feature .meta{font-size:14px;color:var(--gold);font-weight:500}
.panel{margin-top:40px;padding:36px;border-radius:var(--radius-xl);border:1px solid var(--border);background:linear-gradient(180deg,rgba(255,255,255,.08),rgba(255,255,255,.035));box-shadow:var(--shadow)}
.panel h2{margin:0 0 14px;font-size:24px;font-weight:600}
.panel p{font-size:17px;line-height:1.7;color:var(--muted);max-width:720px;margin:0 0 16px}
.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px;margin-top:20px}
.step{padding:16px 18px;border-radius:var(--radius-lg);border:1px solid rgba(214,194,143,.35);background:rgba(214,194,143,.07);font-size:14.5px;color:var(--muted)}
.step b{display:block;color:var(--gold);font-size:13px;letter-spacing:.1em;text-transform:uppercase;margin-bottom:4px}
footer{margin:56px 0 80px;text-align:center;font-size:13px;color:var(--muted-2)}
.reveal{opacity:0;transform:translateY(24px);transition:opacity .8s,transform .8s}.reveal.in{opacity:1;transform:none}
@media(max-width:600px){.feature,.panel{padding:26px}}
@media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none}}
